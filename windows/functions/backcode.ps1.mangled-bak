<#
================================================================================
 backcode - ZCode backup engine (standalone)
================================================================================
 Backs up EVERYTHING ZCode-related from C: to F:\backup\ai\zcode, as fast as
 possible, in an organized layout. Safe to run any time, from any folder.

 WHAT IS BACKED UP (live -> backup, fast mirror /E /B (locked files included via backup mode)):
   C:\Users\Admin\.zcode                -> F:\backup\ai\zcode\dot-zcode
      (sessions, data, skills, slash commands, workflows, cli state)
      EXCLUDED (volatile junk): .zcode\tmp, .zcode\cli\exec, root *.log
   C:\Users\Admin\AppData\Roaming\zcode -> F:\backup\ai\zcode\roaming-zcode

 ALSO MAINTAINED:
   F:\backup\ai\zcode\tools\backcode.ps1   (this engine, self-updated)
   F:\backup\ai\zcode\BACKUP-MANIFEST.txt  (run log + integrity numbers)

 Mirror semantics: files deleted/changed on C: are deleted/updated in the
 backup, so the backup is always the latest state. Robocopy /MT:16 for speed.
================================================================================
#>
$ErrorActionPreference = 'Continue'
$sw = [System.Diagnostics.Stopwatch]::StartNew()
$backupRoot = 'F:\backup\ai\zcode'
New-Item $backupRoot -ItemType Directory -Force | Out-Null
New-Item (Join-Path $backupRoot 'tools') -ItemType Directory -Force | Out-Null

# self-update the engine copy inside the backup
$self = $PSCommandPath
if ($self -and ((Split-Path $self -Parent) -ne (Join-Path $backupRoot 'tools'))) {
    try { Copy-Item -LiteralPath $self -Destination (Join-Path $backupRoot 'tools\backcode.ps1') -Force } catch { }
}

$pairs = [ordered]@{
    'C:\Users\Admin\.zcode'                = Join-Path $backupRoot 'dot-zcode'
    'C:\Users\Admin\AppData\Roaming\zcode' = Join-Path $backupRoot 'roaming-zcode'
}
$manifest = [System.Collections.Generic.List[string]]::new()
$manifest.Add(('BACKCODE RUN ' + (Get-Date -Format 'yyyy-MM-dd HH:mm:ss')))
$globalFail = $false

foreach ($src in $pairs.Keys) {
    $dst = $pairs[$src]
    if (-not (Test-Path -LiteralPath $src)) {
        Write-Host ("[backcode] SKIP missing source: " + $src) -ForegroundColor Yellow
        $manifest.Add(('SKIP,' + $src + ',missing source'))
        continue
    }
    $xdFull = @()
    if ($src -like '*.zcode') { $xdFull = @((Join-Path $src 'tmp'), (Join-Path $src 'cli\exec')) }

    $srcFiles = @(Get-ChildItem $src -Recurse -File -Force -ErrorAction SilentlyContinue | Where-Object {
        $fn = $_.FullName
        -not ($xdFull | Where-Object { $fn -eq $_ -or $fn.StartsWith($_ + '\') })
    })
    $srcBytes = ($srcFiles | Measure-Object Length -Sum).Sum

    $swRun = [System.Diagnostics.Stopwatch]::StartNew()
    if ($xdFull.Count -gt 0) {
        & robocopy $src $dst /MIR /MT:16 /COPY:DAT /DCOPY:DAT /COPYALL /R:0 /W:1 /B /XD @($xdFull) /NFL /NDL /NP /V /LOG+:F:\backup\ai\zcode\logs\backcode-robocopy.log
    } else {
        & robocopy $src $dst /MIR /MT:16 /COPY:DAT /DCOPY:DAT /COPYALL /R:0 /W:1 /B /NFL /NDL /NP
    }
    $rc = $LASTEXITCODE
    $swRun.Stop()
    if ($rc -ge 16) { $globalFail = $true }
    Write-Host ("[backcode] {0} -> backup  exit={1}  files={2}  {3:N1} MB  {4}s" -f `
        (Split-Path $src -Leaf), $rc, $srcFiles.Count, ($srcBytes / 1MB), [math]::Round($swRun.Elapsed.TotalSeconds, 1))
    $manifest.Add(('MIRROR,' + $src + ',' + $dst + ',exit=' + $rc + ',files=' + $srcFiles.Count + ',bytes=' + $srcBytes))
}

$$sq3 = 'C:\Users\Admin\AppData\Local\Android\platform-tools\sqlite3.exe'
$liveDb = 'C:\Users\Admin\.zcode\cli\db\db.sqlite'
if ((Test-Path $sq3) -and (Test-Path $liveDb)) {
    $dbDir = Join-Path $backupRoot 'databases'
    New-Item $dbDir -ItemType Directory -Force | Out-Null
    $dbBak = Join-Path $dbDir 'db.sqlite'
    & $sq3 $liveDb (".backup '" + $dbBak + "'") 2>$null | Out-Null
    $ic = & $sq3 $dbBak 'PRAGMA integrity_check;' 2>$null
    Write-Host ("[backcode] sessions DB safe-backed up (integrity: " + (($ic | Select-Object -First 1))) ")" -ForegroundColor Green
    $manifest.Add(('DB-SAFE-BACKUP,' + $liveDb + ',' + $dbBak + ',integrity=' + (($ic | Select-Object -First 1))))
}nmanifest.Add(('DONE in ' + [math]::Round($sw.Elapsed.TotalSeconds, 1) + 's; globalFail=' + $globalFail))
$manifest | Set-Content -LiteralPath (Join-Path $backupRoot 'BACKUP-MANIFEST.txt') -Encoding UTF8
$sw.Stop()
if ($globalFail) { Write-Host '[backcode] COMPLETED WITH ERRORS (see manifest)' -ForegroundColor Red }
else { Write-Host '[backcode] BACKUP COMPLETE - latest ZCode state mirrored to F:\backup\ai\zcode' -ForegroundColor Green }
