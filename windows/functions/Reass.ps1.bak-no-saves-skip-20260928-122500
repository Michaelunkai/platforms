[CmdletBinding(SupportsShouldProcess = $true)]
param(
    [Parameter(Position = 0)][string]$Game,
    [string]$GameExecutable,
    [string]$ExpectedBackupManifest,
    [string]$ExpectedBackupManifestSha256,
    [string]$ResultPath,
    [switch]$VerifyOnly,
    [switch]$SelfTest,
    [Parameter(DontShow = $true)][string]$BackupRoot = 'F:\backup\gamesaves'
)

$ErrorActionPreference = 'Stop'
$backupRoot = [IO.Path]::GetFullPath($BackupRoot).TrimEnd('\')
$mutex = New-Object System.Threading.Mutex($false, 'Global\ReassLatestGameRestore')
$ownsMutex = $false

if ($ResultPath -and (-not [IO.Path]::IsPathRooted($ResultPath) -or [IO.Path]::GetExtension($ResultPath) -ine '.json')) {
    throw 'reass: ResultPath must be an absolute .json path'
}
if ($ExpectedBackupManifest) {
    if (-not [IO.Path]::IsPathRooted($ExpectedBackupManifest) -or [IO.Path]::GetExtension($ExpectedBackupManifest) -ine '.json') {
        throw 'reass: ExpectedBackupManifest must be an absolute .json path'
    }
    if ($ExpectedBackupManifestSha256 -notmatch '\A[0-9a-fA-F]{64}\z') {
        throw 'reass: ExpectedBackupManifestSha256 must be a 64-character SHA256 when a manifest is pinned'
    }
} elseif ($ExpectedBackupManifestSha256) {
    throw 'reass: ExpectedBackupManifestSha256 requires ExpectedBackupManifest'
}

function Write-ReassResult([hashtable]$Data) {
    if (-not $ResultPath) { return }
    $path = [IO.Path]::GetFullPath($ResultPath)
    $folder = [IO.Path]::GetDirectoryName($path)
    [IO.Directory]::CreateDirectory($folder) | Out-Null
    $temporary = $path + '.tmp-' + [guid]::NewGuid().ToString('N')
    $json = $Data | ConvertTo-Json -Depth 12
    [IO.File]::WriteAllText($temporary, $json, (New-Object System.Text.UTF8Encoding($false)))
    if ([IO.File]::Exists($path)) { [IO.File]::Replace($temporary, $path, $null) }
    else { [IO.File]::Move($temporary, $path) }
}

function Write-ReassState([string]$Stage, [string]$Text) {
    Write-Host (("REASS_PROGRESS stage={0} {1}" -f $Stage, $Text).TrimEnd()) -ForegroundColor Cyan
}

function Get-ReassHash([string]$Path) {
    $stream = [IO.File]::Open($Path, 'Open', 'Read', 'Read')
    try {
        $sha = [Security.Cryptography.SHA256]::Create()
        try { ([BitConverter]::ToString($sha.ComputeHash($stream)) -replace '-', '') }
        finally { $sha.Dispose() }
    } finally { $stream.Dispose() }
}

function Get-ReassFiles([string]$Path) {
    if ([IO.File]::Exists($Path)) { return ,(Get-Item -LiteralPath $Path -Force -ErrorAction Stop) }
    if (-not [IO.Directory]::Exists($Path)) { return @() }
    @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $Path -Recurse -Force -File -ErrorAction Stop |
        Where-Object { -not ($_.Attributes -band [IO.FileAttributes]::ReparsePoint) })
}

function Get-ReassDirectories([string]$Path) {
    if (-not [IO.Directory]::Exists($Path)) { return @() }
    $root = [IO.Path]::GetFullPath($Path).TrimEnd('\')
    @(Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $root -Recurse -Force -Directory -ErrorAction Stop |
        Where-Object { -not ($_.Attributes -band [IO.FileAttributes]::ReparsePoint) } |
        ForEach-Object { $_.FullName.Substring($root.Length).TrimStart('\') } |
        Sort-Object -CaseSensitive)
}

function Get-ReassManifest([string]$Path) {
    $full = [IO.Path]::GetFullPath($Path).TrimEnd('\')
    $isFile = [IO.File]::Exists($full)
    $items = foreach ($file in @(Get-ReassFiles $full)) {
        $relative = if ($isFile) { [IO.Path]::GetFileName($full) } else { $file.FullName.Substring($full.Length).TrimStart('\') }
        [pscustomobject]@{Path=$relative;Bytes=[int64]$file.Length;Sha256=(Get-ReassHash $file.FullName)}
    }
    @($items | Sort-Object Path)
}

function Test-ReassEqual([string]$Expected, [string]$Actual) {
    $expectedIsFile = [IO.File]::Exists($Expected)
    $actualIsFile = [IO.File]::Exists($Actual)
    if ($expectedIsFile -or $actualIsFile) {
        if (-not ($expectedIsFile -and $actualIsFile)) { return $false }
        $expectedItem = Get-Item -LiteralPath $Expected -Force -ErrorAction Stop
        $actualItem = Get-Item -LiteralPath $Actual -Force -ErrorAction Stop
        return ($expectedItem.Length -eq $actualItem.Length -and
            (Get-ReassHash $Expected) -ieq (Get-ReassHash $Actual))
    }
    if (-not ([IO.Directory]::Exists($Expected) -and [IO.Directory]::Exists($Actual))) { return $false }
    $a = @(Get-ReassManifest $Expected); $b = @(Get-ReassManifest $Actual)
    if ($a.Count -ne $b.Count) { return $false }
    for ($i = 0; $i -lt $a.Count; $i++) {
        if ($a[$i].Path -cne $b[$i].Path -or $a[$i].Bytes -ne $b[$i].Bytes -or $a[$i].Sha256 -ne $b[$i].Sha256) { return $false }
    }
    $aDirectories = @(Get-ReassDirectories $Expected); $bDirectories = @(Get-ReassDirectories $Actual)
    if ($aDirectories.Count -ne $bDirectories.Count) { return $false }
    for ($i = 0; $i -lt $aDirectories.Count; $i++) {
        if ($aDirectories[$i] -cne $bDirectories[$i]) { return $false }
    }
    $true
}

function Copy-ReassItem([string]$Source, [string]$Destination) {
    if ([IO.File]::Exists($Source)) {
        [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($Destination)) | Out-Null
        [IO.File]::Copy($Source, $Destination, $true)
        [IO.File]::SetLastWriteTimeUtc($Destination, [IO.File]::GetLastWriteTimeUtc($Source))
    } elseif ([IO.Directory]::Exists($Source)) {
        [IO.Directory]::CreateDirectory($Destination) | Out-Null
        $root = [IO.Path]::GetFullPath($Source).TrimEnd('\')
        foreach ($relative in @(Get-ReassDirectories $root)) {
            [IO.Directory]::CreateDirectory((Join-Path $Destination $relative)) | Out-Null
        }
        foreach ($file in @(Get-ReassFiles $root)) {
            $relative = $file.FullName.Substring($root.Length).TrimStart('\')
            $target = Join-Path $Destination $relative
            [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($target)) | Out-Null
            [IO.File]::Copy($file.FullName, $target, $true)
            [IO.File]::SetLastWriteTimeUtc($target, $file.LastWriteTimeUtc)
        }
    } else { throw "reass: backup payload is missing: $Source" }
    if (-not (Test-ReassEqual $Source $Destination)) { throw "reass: copy verification failed: $Destination" }
}

function Remove-ReassItem([string]$Path) {
    if ([IO.File]::Exists($Path)) { [IO.File]::Delete($Path) }
    elseif ([IO.Directory]::Exists($Path)) { [IO.Directory]::Delete($Path, $true) }
}

function Move-ReassItem([string]$Source, [string]$Destination) {
    if ([IO.File]::Exists($Source)) { [IO.File]::Move($Source, $Destination) }
    elseif ([IO.Directory]::Exists($Source)) { [IO.Directory]::Move($Source, $Destination) }
    else { throw "reass: move source vanished: $Source" }
}

function Invoke-ReassReg([string[]]$Arguments) {
    $regExe = Join-Path ([Environment]::SystemDirectory) 'reg.exe'
    $previous = $ErrorActionPreference
    try {
        $ErrorActionPreference = 'Continue'
        $output = @(& $regExe @Arguments 2>&1 | ForEach-Object {[string]$_})
        [pscustomobject]@{ExitCode=[int]$LASTEXITCODE;Output=($output -join ' | ')}
    } finally { $ErrorActionPreference = $previous }
}

function Test-ReassRegistryEqual([string]$Expected, [string]$Actual) {
    $expectedLines = @([IO.File]::ReadAllText($Expected) -split "`r`n|`n|`r" |
        Where-Object {$_ -and $_ -notmatch '^(?:Windows Registry Editor Version|REGEDIT4)'})
    $actualLines = @([IO.File]::ReadAllText($Actual) -split "`r`n|`n|`r" |
        Where-Object {$_ -and $_ -notmatch '^(?:Windows Registry Editor Version|REGEDIT4)'})
    if ($expectedLines.Count -ne $actualLines.Count) { return $false }
    for ($i = 0; $i -lt $expectedLines.Count; $i++) {
        if ($expectedLines[$i] -cne $actualLines[$i]) { return $false }
    }
    $true
}

function Assert-ReassRegistryTarget([string]$Key) {
    $canonical = $Key.Replace('/','\').TrimEnd('\')
    $canonical = $canonical -replace '(?i)^HKEY_CURRENT_USER(?=\\|$)','HKCU' -replace '(?i)^HKEY_LOCAL_MACHINE(?=\\|$)','HKLM'
    if ($canonical -notmatch '(?i)^(?:HKCU|HKLM)\\[^\\]+\\[^\\]+' -or
        $canonical -match '[\x00-\x1f]' -or $canonical -match '\\\\' -or
        $canonical -match '(?:^|\\)\.{1,2}(?:\\|$)') {
        throw "reass: unsafe or shared registry restore root: $Key"
    }
    $relative = $canonical.Substring($canonical.IndexOf('\') + 1)
    # These are shared containers, never one game's settings. Match exact
    # canonical roots so real game-specific descendants remain supported.
    $shared = @('Software\Classes','Software\WOW6432Node','Software\Microsoft',
        'Software\Microsoft\Windows','Software\Microsoft\Windows\CurrentVersion',
        'Software\Microsoft\Windows NT','Software\Microsoft\Windows NT\CurrentVersion',
        'Software\Policies','Software\Policies\Microsoft','Software\Policies\Microsoft\Windows',
        'SYSTEM\CurrentControlSet','SYSTEM\ControlSet001','SYSTEM\ControlSet002')
    $withoutRedirector = $relative -replace '(?i)^Software\\WOW6432Node\\','Software\'
    if ($shared -contains $relative -or $shared -contains $withoutRedirector) {
        throw "reass: shared registry root is not a game restore target: $canonical"
    }
    $canonical
}

function Assert-ReassTarget([string]$Path) {
    $full = [IO.Path]::GetFullPath($Path).TrimEnd('\')
    $root = [IO.Path]::GetPathRoot($full).TrimEnd('\')
    if ($full -ieq $root -or $full.Length -le ($root.Length + 2)) { throw "reass: unsafe restore target: $full" }
    $localRoot = [Environment]::GetFolderPath([Environment+SpecialFolder]::LocalApplicationData)
    $documentsRoot = [Environment]::GetFolderPath([Environment+SpecialFolder]::MyDocuments)
    $sharedRoots = @(
        [IO.Path]::GetTempPath(), (Join-Path $localRoot 'Temp'), $localRoot,
        [Environment]::GetFolderPath([Environment+SpecialFolder]::ApplicationData),
        [Environment]::GetFolderPath([Environment+SpecialFolder]::UserProfile),
        $documentsRoot, (Join-Path $documentsRoot 'My Games'),
        [Environment]::GetFolderPath([Environment+SpecialFolder]::CommonApplicationData),
        [Environment]::GetFolderPath([Environment+SpecialFolder]::Windows)
    )
    foreach ($sharedRoot in $sharedRoots) {
        if ($sharedRoot -and $full -ieq [IO.Path]::GetFullPath($sharedRoot).TrimEnd('\')) {
            throw "reass: shared system or profile root is not a game restore target: $full"
        }
    }
    $backupPrefix = [IO.Path]::GetFullPath($backupRoot).TrimEnd('\') + '\'
    if (($full + '\').StartsWith($backupPrefix, [StringComparison]::OrdinalIgnoreCase)) { throw "reass: target is inside backup repository: $full" }
    $full
}

function Resolve-ReassTarget([string]$Path) {
    $full = [IO.Path]::GetFullPath($Path).TrimEnd('\')
    $currentProfile = [IO.Path]::GetFullPath([Environment]::GetFolderPath([Environment+SpecialFolder]::UserProfile)).TrimEnd('\')
    $match = [regex]::Match($full, '^(?<profile>[A-Za-z]:\\Users\\[^\\]+)(?<suffix>\\.*)?$', [Text.RegularExpressions.RegexOptions]::IgnoreCase)
    if ($match.Success) {
        $recordedProfile = $match.Groups['profile'].Value.TrimEnd('\')
        if ($recordedProfile -ine $currentProfile -and
            $recordedProfile -notmatch '(?i)\\(?:Public|Default(?: User)?|All Users)$') {
            $suffix = $match.Groups['suffix'].Value.TrimStart('\')
            $mapped = if ($suffix) { Join-Path $currentProfile $suffix } else { $currentProfile }
            Write-ReassState 'resolved-user-profile-target' ("recorded=[{0}] target=[{1}]" -f $full,$mapped)
            return [IO.Path]::GetFullPath($mapped).TrimEnd('\')
        }
    }
    $full
}

function Get-ReassBackups {
    if (-not [IO.Directory]::Exists($backupRoot)) { throw "reass: backup root not found: $backupRoot" }
    foreach ($directory in Microsoft.PowerShell.Management\Get-ChildItem -LiteralPath $backupRoot -Directory -Force -ErrorAction Stop) {
        if ($directory.Name -like 'pre-restore_*' -or $directory.Name -like '*.partial-*') { continue }
        $auditPath = Join-Path $directory.FullName 'backup.json'
        $hasAudit = [IO.File]::Exists($auditPath)
        $hasSaveRoot = [IO.Directory]::Exists((Join-Path $directory.FullName 'SaveGames'))
        $looksLikeFinalBackup = $directory.Name -match '_\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2}-\d{3}_[0-9a-fA-F]{8}$'
        if (-not $hasAudit -and -not $hasSaveRoot -and -not $looksLikeFinalBackup) { continue }
        $audit = $null
        $metadataError = $null
        $sources = @()
        $stored = @()
        $registryKeys = @()
        $registryFiles = @()
        $createdUtc = $null
        try {
            if ($hasAudit) {
                $audit = Get-Content -LiteralPath $auditPath -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
            } else {
                $metadataError = 'backup.json is missing'
            }
        } catch {
            $metadataError = "backup.json is invalid: $($_.Exception.Message)"
        }
        if ($audit) {
            $sources = @($audit.saveSources | ForEach-Object {[string]$_} | Where-Object {$_})
            if ($null -ne $audit.status -and [string]$audit.status -ine 'complete') {
                $metadataError = "backup status is not complete: $([string]$audit.status)"
            }
            $stored = @($audit.storedUnder | ForEach-Object {if ($null -ne $_) {[string]$_}})
            if ($stored.Count -ne $sources.Count) {
                $stored = @()
                $saveRoot = Join-Path $directory.FullName 'SaveGames'
                for ($index = 0; $index -lt $sources.Count; $index++) {
                    $source = $sources[$index].TrimEnd('\')
                    if ($sources.Count -eq 1) {
                        $leaf = [IO.Path]::GetFileName($source)
                        $singleFile = Join-Path $saveRoot $leaf
                        $stored += $(if ([IO.File]::Exists($singleFile) -and [int64]$audit.files -eq 1) {$leaf} else {''})
                    } else {
                        $leaf = ([IO.Path]::GetFileName($source) -replace '[\\/:*?"<>|]', '_')
                        $folder = ('{0:D2}_{1}' -f ($index + 1),$leaf)
                        $folderPath = Join-Path $saveRoot $folder
                        $filePath = Join-Path $folderPath ([IO.Path]::GetFileName($source))
                        $stored += $(if ([IO.Directory]::Exists($folderPath)) {$folder} elseif ([IO.File]::Exists($filePath)) {Join-Path $folder ([IO.Path]::GetFileName($source))} else {$folder})
                    }
                }
            }

            $createdValue = if ($audit.createdUtc) {$audit.createdUtc} else {$audit.detectedUtc}
            if ($null -ne $createdValue) {
                try {
                    $createdUtc = if ($createdValue -is [DateTimeOffset]) {
                        $createdValue.ToUniversalTime()
                    } elseif ($createdValue -is [DateTime]) {
                        ([DateTimeOffset]$createdValue).ToUniversalTime()
                    } else {
                        [DateTimeOffset]::Parse([string]$createdValue,[Globalization.CultureInfo]::InvariantCulture,[Globalization.DateTimeStyles]::RoundtripKind).ToUniversalTime()
                    }
                } catch {
                    $metadataError = "backup creation time is invalid: $($_.Exception.Message)"
                }
            }
            $registryKeys = @($audit.registryKeys | ForEach-Object {[string]$_} | Where-Object {$_})
            $registryFiles = @($audit.registryFiles | ForEach-Object {[string]$_} | Where-Object {$_})
            if (-not $audit.game -or $null -eq $createdValue -or $sources.Count -eq 0 -or $sources.Count -ne $stored.Count) {
                if (-not $metadataError) { $metadataError = 'backup metadata is missing its game, creation time, or complete save-source mapping' }
            }
        }
        if (-not $createdUtc) {
            $fallbackTime = $directory.CreationTimeUtc
            if ($directory.LastWriteTimeUtc -gt $fallbackTime) { $fallbackTime = $directory.LastWriteTimeUtc }
            if ([IO.File]::Exists($auditPath)) {
                $auditWriteTime = (Get-Item -LiteralPath $auditPath -Force -ErrorAction Stop).LastWriteTimeUtc
                if ($auditWriteTime -gt $fallbackTime) { $fallbackTime = $auditWriteTime }
            }
            $createdUtc = ([DateTimeOffset]$fallbackTime).ToUniversalTime()
            if (-not $metadataError) { $metadataError = 'backup creation time is missing' }
        }
        [pscustomobject]@{Directory=$directory;Audit=$audit;Sources=$sources;Stored=$stored;CreatedUtc=$createdUtc;RegistryKeys=$registryKeys;RegistryFiles=$registryFiles;RegistryResolved=@();MetadataError=$metadataError}
    }
}

function Test-ReassBackup($Candidate) {
    $saveRoot = Join-Path $Candidate.Directory.FullName 'SaveGames'
    if (-not [IO.Directory]::Exists($saveRoot)) { throw "reass: SaveGames payload missing: $saveRoot" }
    $files = @(Get-ReassFiles $saveRoot)
    $Candidate | Add-Member -NotePropertyName Directories -NotePropertyValue @(Get-ReassDirectories $saveRoot) -Force
    $bytes = [int64](($files | Measure-Object Length -Sum).Sum)
    if ($null -ne $Candidate.Audit.files -and [int64]$Candidate.Audit.files -ne $files.Count) { throw 'reass: backup file count mismatch' }
    if ($null -ne $Candidate.Audit.bytes -and [int64]$Candidate.Audit.bytes -ne $bytes) { throw 'reass: backup byte count mismatch' }
    $normalizedGame = ([string]$Candidate.Audit.game -replace '[^A-Za-z0-9]', '').ToLowerInvariant()
    if ($normalizedGame -eq 'echoesoftheend') {
        $payloadNames = @($files | ForEach-Object { $_.Name.ToLowerInvariant() })
        if (-not ($payloadNames -contains '1_data.sav' -and $payloadNames -contains '1_info.sav')) {
            throw 'reass: Echoes of the End backup has no complete playable slot payload'
        }
    }
    $entries = @($Candidate.Audit.fileEntries | Where-Object {$null -ne $_})
    $integrity = 'legacy-count-bytes'
    if ($entries.Count -gt 0) {
        if ($entries.Count -ne $files.Count) { throw 'reass: backup SHA256 manifest is incomplete' }
        $prefix = [IO.Path]::GetFullPath($saveRoot).TrimEnd('\') + '\'
        $seen = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
        foreach ($entry in $entries) {
            $path = [IO.Path]::GetFullPath((Join-Path $Candidate.Directory.FullName ([string]$entry.path)))
            if (-not $path.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase) -or -not [IO.File]::Exists($path) -or -not $seen.Add($path)) { throw "reass: unsafe, duplicate, or missing manifest entry: $($entry.path)" }
            if ([int64](Get-Item -LiteralPath $path -Force).Length -ne [int64]$entry.bytes -or (Get-ReassHash $path) -ine [string]$entry.sha256) { throw "reass: SHA256 mismatch: $($entry.path)" }
        }
        $integrity = 'sha256'
    }
    if ($Candidate.RegistryKeys.Count -ne $Candidate.RegistryFiles.Count) { throw 'reass: registry backup mapping is incomplete' }
    $registryEntries = @($Candidate.Audit.registryEntries | Where-Object {$null -ne $_})
    if ($registryEntries.Count -gt 0 -and $registryEntries.Count -ne $Candidate.RegistryFiles.Count) { throw 'reass: registry SHA256 manifest is incomplete' }
    $rootPrefix = [IO.Path]::GetFullPath($Candidate.Directory.FullName).TrimEnd('\') + '\'
    $resolvedRegistry = @()
    for ($i=0; $i -lt $Candidate.RegistryFiles.Count; $i++) {
        $rawPath = $Candidate.RegistryFiles[$i]
        $path = if ([IO.Path]::IsPathRooted($rawPath)) {[IO.Path]::GetFullPath($rawPath)} else {[IO.Path]::GetFullPath((Join-Path $Candidate.Directory.FullName $rawPath))}
        if (-not $path.StartsWith($rootPrefix,[StringComparison]::OrdinalIgnoreCase) -or -not [IO.File]::Exists($path)) { throw "reass: unsafe or missing registry payload: $rawPath" }
        if ($registryEntries.Count -gt 0) {
            $entry = $registryEntries[$i]
            if ([string]$entry.registryKey -ine $Candidate.RegistryKeys[$i] -or [int64](Get-Item -LiteralPath $path -Force).Length -ne [int64]$entry.bytes -or (Get-ReassHash $path) -ine [string]$entry.sha256) { throw "reass: registry SHA256 mismatch: $rawPath" }
        }
        $resolvedRegistry += $path
    }
    $Candidate.RegistryResolved = $resolvedRegistry
    if ($resolvedRegistry.Count -gt 0) {$integrity += '+registry'}
    $integrity
}

function Select-ReassLatestVerifiedBackup($Candidates) {
    $ordered = @($Candidates | Sort-Object CreatedUtc, @{Expression={$_.Directory.LastWriteTimeUtc}} -Descending)
    if ($ordered.Count -eq 0) { return $null }
    $candidate = $ordered[0]
    # Restoring an older snapshot after the newest one fails verification would silently lose newer progress.
    if ($candidate.MetadataError) {
        Write-ReassState 'latest-backup-invalid' ("created_utc={0:o} path=[{1}] reason=[{2}]" -f $candidate.CreatedUtc,$candidate.Directory.FullName,$candidate.MetadataError)
        throw "reass: newest backup candidate is unusable; refusing to restore an older snapshot: $($candidate.MetadataError)"
    }
    try {
        Write-ReassState 'verifying-selected-backup' ("game=[{0}] created_utc={1:o} path=[{2}]" -f $candidate.Audit.game,$candidate.CreatedUtc,$candidate.Directory.FullName)
        $candidate | Add-Member -NotePropertyName Integrity -NotePropertyValue (Test-ReassBackup $candidate) -Force
        return $candidate
    } catch {
        Write-ReassState 'latest-backup-invalid' ("created_utc={0:o} path=[{1}] reason=[{2}]" -f $candidate.CreatedUtc,$candidate.Directory.FullName,$_.Exception.Message)
        throw "reass: newest backup failed complete integrity verification; refusing to restore an older snapshot: $($_.Exception.Message)"
    }
}

try {
    $ownsMutex = $mutex.WaitOne(0)
    if (-not $ownsMutex) { throw 'reass: another restore is already running' }
    Write-ReassState 'selecting-latest-created-backup' $(if ($Game) {"game=[$Game]"} else {'game=[any]'})
    $candidates = @(Get-ReassBackups)
    if ($GameExecutable) {
        if (-not [IO.Path]::IsPathRooted($GameExecutable) -or [IO.Path]::GetExtension($GameExecutable) -ine '.exe') {
            throw 'reass: GameExecutable must be an absolute executable path'
        }
        $selectedExecutable = [IO.Path]::GetFullPath($GameExecutable)
        $candidates = @($candidates | Where-Object {
            # A known different identity is unrelated even when its payload is
            # invalid. Unidentifiable corrupt candidates still fail closed.
            $recordedExecutable = [string]$_.Audit.executable
            if ($recordedExecutable -and [IO.Path]::IsPathRooted($recordedExecutable)) {
                try { return [IO.Path]::GetFullPath($recordedExecutable) -ieq $selectedExecutable }
                catch { }
            }
            return [bool]$_.MetadataError
        })
    }
    if ($Game) {
        $normalized = $Game -replace '[^A-Za-z0-9]', ''
        $candidates = @($candidates | Where-Object {
            $recordedGame = [string]$_.Audit.game
            [string]::IsNullOrWhiteSpace($recordedGame) -or ($recordedGame -ieq $Game) -or
                (($recordedGame -replace '[^A-Za-z0-9]', '') -ieq $normalized)
        })
    }
    $selected = Select-ReassLatestVerifiedBackup $candidates
    if ($null -eq $selected) { throw $(if ($GameExecutable) {"reass: no completed, valid ass backup found for executable '$GameExecutable'"} elseif ($Game) {"reass: no completed, valid ass backup found for '$Game'"} else {'reass: no completed, valid ass backup found'}) }
    $integrity = $selected.Integrity
    $directoryCount = @($selected.Directories).Count
    $selectedManifest = [IO.Path]::GetFullPath((Join-Path $selected.Directory.FullName 'backup.json'))
    $backupManifestSha256 = (Get-FileHash -LiteralPath $selectedManifest -Algorithm SHA256 -ErrorAction Stop).Hash
    if ($ExpectedBackupManifest) {
        $expectedManifest = [IO.Path]::GetFullPath($ExpectedBackupManifest)
        if (-not [string]::Equals($selectedManifest,$expectedManifest,[StringComparison]::OrdinalIgnoreCase)) {
            throw 'reass: selected latest backup does not match the expected manifest'
        }
        if (-not [string]::Equals($backupManifestSha256,$ExpectedBackupManifestSha256,[StringComparison]::OrdinalIgnoreCase)) {
            throw 'reass: selected backup manifest changed since verify-only; the expected manifest hash does not match'
        }
    }

    $saveRoot = [IO.Path]::GetFullPath((Join-Path $selected.Directory.FullName 'SaveGames')).TrimEnd('\')
    $savePrefix = $saveRoot + '\'
    $plans = @()
    $targetSet = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    for ($i=0; $i -lt $selected.Sources.Count; $i++) {
        $target = Assert-ReassTarget (Resolve-ReassTarget $selected.Sources[$i])
        if (-not $targetSet.Add($target)) { throw "reass: duplicate restore target: $target" }
        $payload = [IO.Path]::GetFullPath((Join-Path $saveRoot $selected.Stored[$i]))
        if (($payload -ine $saveRoot -and -not $payload.StartsWith($savePrefix,[StringComparison]::OrdinalIgnoreCase)) -or (-not [IO.File]::Exists($payload) -and -not [IO.Directory]::Exists($payload))) { throw "reass: unsafe or missing mapped payload: $payload" }
        $hadTarget = [IO.File]::Exists($target) -or [IO.Directory]::Exists($target)
        $plans += [pscustomobject]@{Index=$i;Target=$target;Payload=$payload;HadTarget=$hadTarget;Preserved=$null;Stage=($target+'.reass-stage-'+[guid]::NewGuid().ToString('N'));Rollback=($target+'.reass-rollback-'+[guid]::NewGuid().ToString('N'));Swapped=$false}
    }
    # Older ass builds could record both a directory and one of its children.
    # Restoring both independently is unsafe because swapping the parent would
    # invalidate the child's stage/rollback path. When the child's captured
    # bytes are exactly the same subtree already present in the parent payload,
    # collapse it into the single parent transaction. A disagreement remains a
    # hard failure so no save data is silently discarded.
    $redundantPlanIndexes = New-Object 'System.Collections.Generic.HashSet[int]'
    foreach ($left in $plans) {
        foreach ($right in $plans) {
            if ($left.Index -eq $right.Index) { continue }
            $leftPrefix = $left.Target.TrimEnd('\') + '\'
            if (-not (($right.Target+'\').StartsWith($leftPrefix,[StringComparison]::OrdinalIgnoreCase))) { continue }
            $relativeChild = $right.Target.Substring($leftPrefix.Length).TrimStart('\')
            $parentSubtree = if ($relativeChild) { Join-Path $left.Payload $relativeChild } else { $left.Payload }
            if (([IO.File]::Exists($parentSubtree) -or [IO.Directory]::Exists($parentSubtree)) -and
                (Test-ReassEqual $right.Payload $parentSubtree)) {
                [void]$redundantPlanIndexes.Add([int]$right.Index)
                Write-ReassState 'collapsing-overlapping-target' "child=[$($right.Target)] parent=[$($left.Target)]"
                continue
            }
            throw "reass: overlapping restore targets contain different data: $($left.Target) and $($right.Target)"
        }
    }
    if ($redundantPlanIndexes.Count -gt 0) {
        $plans = @($plans | Where-Object { -not $redundantPlanIndexes.Contains([int]$_.Index) })
    }
    $registryPlans = @()
    for ($i=0; $i -lt $selected.RegistryKeys.Count; $i++) {
        $key = Assert-ReassRegistryTarget $selected.RegistryKeys[$i]
        $registryPlans += [pscustomobject]@{Index=$i;Key=$key;Payload=$selected.RegistryResolved[$i];HadKey=$false;Preserved=$null;Touched=$false}
    }
    $allTargets = @($plans.Target) + @($registryPlans.Key)
    if ($VerifyOnly -or $SelfTest) {
        Write-ReassResult @{
            schemaVersion=1;operation='restore';selectedExecutable=$selectedExecutable;outcome='verified'
            receiptDirectory=$selected.Directory.FullName;backupManifest=$selectedManifest;backupManifestSha256=$backupManifestSha256
            fileCount=[int]$selected.Audit.files;registryCount=$selected.RegistryKeys.Count;verifiedBytes=[long]$selected.Audit.bytes
            integrity='verified';preRestoreRollback=$null;errorCode=$null;errorMessage=$null
        }
        Write-Output ("REASS_VERIFY_OK game=[{0}] created_utc={1:o} integrity={2} sources={3} directories={4} targets={5} registry_keys={6} path=[{7}]" -f $selected.Audit.game,$selected.CreatedUtc,$integrity,$selected.Sources.Count,$directoryCount,$plans.Count,$registryPlans.Count,$selected.Directory.FullName)
        $global:LASTEXITCODE = 0; return
    }
    if (-not $PSCmdlet.ShouldProcess(($allTargets -join '; '),"Restore latest verified backup for $($selected.Audit.game)")) {
        Write-Output ("REASS_PREVIEW_OK game=[{0}] created_utc={1:o} sources={2} backup=[{3}]" -f $selected.Audit.game,$selected.CreatedUtc,$selected.Sources.Count,$selected.Directory.FullName)
        $global:LASTEXITCODE = 0; return
    }

    $safeGame = ([string]$selected.Audit.game -replace '[^A-Za-z0-9._-]', '_')
    $preRestore = Join-Path $backupRoot ("pre-restore_{0}_{1}_{2}" -f $safeGame,(Get-Date -Format 'yyyy-MM-dd_HH-mm-ss-fff'),[guid]::NewGuid().ToString('N'))
    [IO.Directory]::CreateDirectory($preRestore) | Out-Null
    $receipt = [ordered]@{version=1;status='started';game=[string]$selected.Audit.game;sourceBackup=$selected.Directory.FullName;startedUtc=[DateTimeOffset]::UtcNow;targets=@()}
    $receiptPath = Join-Path $preRestore 'pre-restore.json'
    $receipt | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $receiptPath -Encoding UTF8

    try {
        foreach ($registryPlan in $registryPlans) {
            $query = Invoke-ReassReg @('query',$registryPlan.Key)
            $registryPlan.HadKey = $query.ExitCode -eq 0
            if ($registryPlan.HadKey) {
                $registryFolder = Join-Path $preRestore 'Registry'
                [IO.Directory]::CreateDirectory($registryFolder) | Out-Null
                $registryPlan.Preserved = Join-Path $registryFolder ("{0:D2}_current.reg" -f ($registryPlan.Index+1))
                $export = Invoke-ReassReg @('export',$registryPlan.Key,$registryPlan.Preserved,'/y')
                if ($export.ExitCode -ne 0 -or -not [IO.File]::Exists($registryPlan.Preserved)) { throw "reass: could not preserve current registry key '$($registryPlan.Key)': $($export.Output)" }
            }
        }
        $stageOrdinal = 0
        foreach ($plan in $plans) {
            $stageOrdinal++
            $plan.Preserved = Join-Path $preRestore ("{0:D2}_{1}" -f ($plan.Index+1),[IO.Path]::GetFileName($plan.Target))
            if ($plan.HadTarget) { Write-ReassState 'preserving-current-target' "target=[$($plan.Target)]"; Copy-ReassItem $plan.Target $plan.Preserved }
            Write-ReassState 'staging-verified-restore' ("index={0}/{1} target=[{2}]" -f $stageOrdinal,$plans.Count,$plan.Target)
            Copy-ReassItem $plan.Payload $plan.Stage
        }
        foreach ($plan in $plans) {
            if ($plan.HadTarget) { Move-ReassItem $plan.Target $plan.Rollback }
            Move-ReassItem $plan.Stage $plan.Target
            $plan.Swapped = $true
            if (-not (Test-ReassEqual $plan.Payload $plan.Target)) { throw "reass: final target verification failed: $($plan.Target)" }
        }
        foreach ($registryPlan in $registryPlans) {
            if ($registryPlan.HadKey) {
                $registryPlan.Touched = $true
                $delete = Invoke-ReassReg @('delete',$registryPlan.Key,'/f')
                if ($delete.ExitCode -ne 0) { throw "reass: could not replace registry key '$($registryPlan.Key)': $($delete.Output)" }
                $query = Invoke-ReassReg @('query',$registryPlan.Key)
                if ($query.ExitCode -eq 0) { throw "reass: registry key remained after replacement delete: $($registryPlan.Key)" }
            } else {
                $query = Invoke-ReassReg @('query',$registryPlan.Key)
                if ($query.ExitCode -eq 0) { throw "reass: registry key appeared after preservation; refusing to merge over it: $($registryPlan.Key)" }
                $registryPlan.Touched = $true
            }
            $import = Invoke-ReassReg @('import',$registryPlan.Payload)
            if ($import.ExitCode -ne 0) { throw "reass: registry restore failed for '$($registryPlan.Key)': $($import.Output)" }
            $query = Invoke-ReassReg @('query',$registryPlan.Key)
            if ($query.ExitCode -ne 0) { throw "reass: restored registry key was not found: $($registryPlan.Key)" }
            $registryFolder = Join-Path $preRestore 'Registry'
            [IO.Directory]::CreateDirectory($registryFolder) | Out-Null
            $verifiedPath = Join-Path $registryFolder ("{0:D2}_restored.reg" -f ($registryPlan.Index+1))
            $export = Invoke-ReassReg @('export',$registryPlan.Key,$verifiedPath,'/y')
            if ($export.ExitCode -ne 0 -or -not [IO.File]::Exists($verifiedPath)) { throw "reass: could not verify restored registry key '$($registryPlan.Key)': $($export.Output)" }
            if (-not (Test-ReassRegistryEqual $registryPlan.Payload $verifiedPath)) { throw "reass: restored registry contents do not exactly match the backup: $($registryPlan.Key)" }
        }
    } catch {
        $restoreError = $_
        $rollbackErrors = @()
        foreach ($registryPlan in @($registryPlans | Where-Object {$_.Touched} | Sort-Object Index)) {
            $query = Invoke-ReassReg @('query',$registryPlan.Key)
            if ($query.ExitCode -eq 0) {
                $undo = Invoke-ReassReg @('delete',$registryPlan.Key,'/f')
                if ($undo.ExitCode -ne 0) { $rollbackErrors += "registry rollback delete failed for '$($registryPlan.Key)': $($undo.Output)" }
            }
        }
        foreach ($registryPlan in @($registryPlans | Where-Object {$_.Touched -and $_.HadKey} | Sort-Object Index)) {
            $undo = Invoke-ReassReg @('import',$registryPlan.Preserved)
            if ($undo.ExitCode -ne 0) { $rollbackErrors += "registry rollback failed for '$($registryPlan.Key)': $($undo.Output)" }
        }
        foreach ($registryPlan in @($registryPlans | Where-Object {$_.Touched -and $_.HadKey} | Sort-Object Index)) {
            $checkPath = Join-Path $preRestore 'Registry' ("{0:D2}_rollback-check.reg" -f ($registryPlan.Index+1))
            $check = Invoke-ReassReg @('export',$registryPlan.Key,$checkPath,'/y')
            if ($check.ExitCode -ne 0 -or -not [IO.File]::Exists($checkPath) -or -not (Test-ReassRegistryEqual $registryPlan.Preserved $checkPath)) {
                $rollbackErrors += "registry rollback verification failed for '$($registryPlan.Key)': $($check.Output)"
            }
        }
        foreach ($plan in @($plans | Sort-Object Index -Descending)) {
            try {
                if ($plan.Swapped) { Remove-ReassItem $plan.Target }
                if ($plan.HadTarget -and ([IO.File]::Exists($plan.Rollback) -or [IO.Directory]::Exists($plan.Rollback))) { Move-ReassItem $plan.Rollback $plan.Target }
            } catch { $rollbackErrors += "file rollback failed for '$($plan.Target)': $($_.Exception.Message)" }
        }
        $receipt.status='rolled-back';$receipt.failedUtc=[DateTimeOffset]::UtcNow;$receipt.error=$restoreError.Exception.Message
        if ($rollbackErrors.Count -gt 0) {$receipt.rollbackErrors=$rollbackErrors}
        $receipt | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $receiptPath -Encoding UTF8
        if ($rollbackErrors.Count -gt 0) { throw ("reass: restore failed: {0}; rollback errors: {1}" -f $restoreError.Exception.Message,($rollbackErrors -join '; ')) }
        throw $restoreError
    } finally {
        foreach ($plan in $plans) { Remove-ReassItem $plan.Stage }
    }
    foreach ($plan in $plans) {
        try {
            if ($plan.HadTarget) { Remove-ReassItem $plan.Rollback }
        } catch { Write-ReassState 'cleanup-deferred' "path=[$($plan.Rollback)]" }
        $receipt.targets += [ordered]@{target=$plan.Target;payload=$plan.Payload;preserved=$plan.Preserved}
    }
    $receipt.registryTargets = @($registryPlans | ForEach-Object {[ordered]@{key=$_.Key;payload=$_.Payload;preserved=$_.Preserved}})
    $receipt.status='complete';$receipt.completedUtc=[DateTimeOffset]::UtcNow
    $receipt | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $receiptPath -Encoding UTF8
    Write-ReassResult @{
        schemaVersion=1;operation='restore';selectedExecutable=$selectedExecutable;outcome='restored'
        receiptDirectory=$preRestore;backupManifest=$selectedManifest;backupManifestSha256=$backupManifestSha256
        fileCount=[int]$selected.Audit.files;registryCount=$selected.RegistryKeys.Count;verifiedBytes=[long]$selected.Audit.bytes
        integrity='verified';preRestoreRollback=$preRestore;errorCode=$null;errorMessage=$null
    }
    Write-Output ("REASS_OK game=[{0}] created_utc={1:o} sources={2} directories={3} effective_targets={4} pre_restore=[{5}] backup=[{6}]" -f $selected.Audit.game,$selected.CreatedUtc,$selected.Sources.Count,$directoryCount,$plans.Count,$preRestore,$selected.Directory.FullName)
    $global:LASTEXITCODE = 0
} catch {
    $global:LASTEXITCODE = 1
    try {
        Write-ReassResult @{
            schemaVersion=1;operation='restore';selectedExecutable=$GameExecutable;outcome='failed'
            receiptDirectory=$null;backupManifest=$null;backupManifestSha256=$null;fileCount=0;registryCount=0;verifiedBytes=0
            integrity='failed';preRestoreRollback=$null;errorCode=$_.Exception.GetType().Name
            errorMessage=$_.Exception.Message
        }
    } catch { Write-Warning ("reass: could not write result receipt: " + $_.Exception.Message) }
    Write-Error -ErrorRecord $_
} finally {
    if ($ownsMutex) { try {$mutex.ReleaseMutex()} catch {} }
    $mutex.Dispose()
}
